{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chihuahua-wangeki",
  "main": "src/index.js",
  "compatibility_date": "2024-12-01",
  "durable_objects": {
    "bindings": [
      { "name": "GAME_ROOM", "class_name": "GameRoom" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["GameRoom"] }
  ],
  "observability": { "enabled": true }
}
